# OkShield — variables de entorno locales.
# Copia este archivo a `.env` (ignorado por Git) y completa los valores reales.

# Raspberry Pi de pruebas (Tailscale/LAN)
RPI_HOST=
RPI_USER=
RPI_PASS=

# Receptor OTLP embebido
OKSHIELD_OTLP_GRPC_ADDR=127.0.0.1:4317
OKSHIELD_OTLP_HTTP_ADDR=127.0.0.1:4318

# Almacenamiento DuckDB
OKSHIELD_DB_PATH=./data/okshield.duckdb
OKSHIELD_RETENTION=24h
